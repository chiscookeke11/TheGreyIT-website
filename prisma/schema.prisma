generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

model Blog {
  id               Int      @id @default(autoincrement())
  title            String
  category         String
  author           String
  content          String
  image            String
  createdAt        DateTime @default(now())

  @@schema("public")
}

model Course {
  id          Int     @id @default(autoincrement())
  title       String
  description String
  duration    String
  price       Int
  imageUrl    String
  rating      Int

  @@schema("public")
}
